# Install the kit (file:..) as a copy of its packed files, the way an app gets
# it from npm, rather than as a link back to the repo. So the demo loads the
# kit's preload, CSS and page script from its own node_modules, as an app does,
# and electron-builder packs that copy into app.asar. After changing the kit,
# run npm install here again to refresh the copy.
install-links=true
